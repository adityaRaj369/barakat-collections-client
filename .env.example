# ------------------------------------------------------------------
# KALAKART environment configuration
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# Database (SQLite by default — zero setup for local/demo).
# To move to Postgres later, change the provider in prisma/schema.prisma
# and set a Postgres URL here, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Public site URL (used for SEO canonical, sitemap, auth callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Auth (NextAuth / Auth.js)
# ------------------------------------------------------------------
# Generate a strong secret:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Admin access — any account whose email is listed here (comma-separated)
# becomes an admin and can open /admin. Register/sign in with this email.
ADMIN_EMAILS="admin@barakatcollections.com"
# Optional server-only fallback admin password for the emails above.
# Prefer seeding a hashed database user for production.
ADMIN_PASSWORD=""
# Demo mode is hardcoded on for this public demo build.
# /login redirects to /admin and admin APIs bypass auth.
DEMO_ADMIN_BYPASS="true"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------
# Payments (Razorpay) — leave blank to run in DEMO mode (no real charge).
# Get keys at https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# The key id must also be exposed to the browser for the checkout widget:
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
